{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "http://localhost:8080/subpath/",
        "http://localhost:8080/subpath/posts/",
        "http://localhost:8080/subpath/showcase/",
        "http://localhost:8080/subpath/showcase/posts/",
        "http://localhost:8080/subpath/showcase/posts/2026/02/diagrams-and-everything-else-on-this-page/",
        "http://localhost:8080/subpath/showcase/ar/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0 }],
        "categories:performance": ["warn", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
