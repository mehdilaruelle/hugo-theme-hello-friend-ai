{{- /*
  Hugo's built-in sitemap, kept line for line apart from two corrections, so the
  next Hugo release is a readable diff.

  A noindex page was still submitted -- Search Console calls that "Submitted URL
  marked 'noindex'". noindex.html holds the rule and head.html asks the same
  partial, so the tag and the entry cannot disagree.

  Alternates were named by .Language.Locale where head.html uses .Language.Lang,
  with no x-default: two annotation sets for one URL. A noindex translation is
  dropped from the set, since a variant advertised here needs a <url> entry of
  its own and does not get one.
*/ -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $primary := (index hugo.Sites 0).Language.Lang }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range partial "listable.html" (where .Pages "Sitemap.Disable" "ne" true) }}
  {{- if and .Permalink (not (partial "noindex.html" .)) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- /* A set naming only this page says nothing worth saying. */}}
    {{- $alternates := partial "alternates.html" . }}
    {{- if gt (len $alternates) 1 }}
    {{- range $alternates }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}" />
    {{- if eq .Language.Lang $primary }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ .Permalink }}" />
    {{- end }}
    {{- end }}
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
